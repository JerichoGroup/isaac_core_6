            custom double inputs:pose:position:latitude
            prepend double inputs:pose:position:latitude.connect = </Root/PoseSync/break_3_vector.outputs:x>
            custom double inputs:pose:position:longitude
            prepend double inputs:pose:position:longitude.connect = </Root/PoseSync/break_3_vector.outputs:y>
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom string inputs:topicName = "/isaac_core/global_pose"
            token node:type = "isaacsim.ros2.bridge.ROS2Publisher"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
