def Xform "Root"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def OmniGraph "BboxExport"
    {
        token evaluationMode = "Automatic"
        token evaluator:type = "execution"
        token fabricCacheBacking = "StageWithoutHistory"
        int2 fileFormatVersion = (1, 9)
        token pipelineStage = "pipelineStageSimulation"

        def OmniGraphNode "on_playback_tick" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            token node:type = "omni.graph.action.OnPlaybackTick"
            int node:typeVersion = 2
            custom double outputs:deltaSeconds
            custom double outputs:frame
            custom uint outputs:tick (
                customData = {
                    bool isExecution = 1
                }
            )
            custom double outputs:time
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (172.40897, 5.95518)
        }

        def OmniGraphNode "isaac_read_simulation_time" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint64 inputs:referenceTimeDenominator
            custom int64 inputs:referenceTimeNumerator
            custom bool inputs:resetOnStop
            token node:type = "isaacsim.core.nodes.IsaacReadSimulationTime"
            int node:typeVersion = 1
            custom double outputs:simulationTime
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (167.68292, 174.00923)
        }

        def OmniGraphNode "seconds_to_ros_stamp" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Root/BboxExport/on_playback_tick.outputs:tick>
            custom double inputs:seconds
            prepend double inputs:seconds.connect = </Root/BboxExport/isaac_read_simulation_time.outputs:simulationTime>
            token node:type = "isaac_core_ogn.math.SecondsToRosStamp"
            int node:typeVersion = 1
            custom uint outputs:nanosec
            custom int outputs:sec
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (546.4858, 567.8606)
        }

        def OmniGraphNode "ros2_context" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom uchar inputs:domain_id
            custom bool inputs:useDomainIDEnvVar
            token node:type = "isaacsim.ros2.bridge.ROS2Context"
            int node:typeVersion = 2
            custom uint64 outputs:context
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (175.38493, 341.18732)
        }

        def OmniGraphNode "bbox_projector" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom token inputs:cameraPath
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Root/BboxExport/on_playback_tick.outputs:tick>
            custom token inputs:targetsRootPath
            token node:type = "isaac_core_ogn.sensors.BboxProjector"
            int node:typeVersion = 1
            custom float[] outputs:alt
            custom int outputs:count
            custom float[] outputs:distance_x
            custom float[] outputs:distance_y
            custom float[] outputs:distance_z
            custom bool[] outputs:in_frame
            custom bool[] outputs:is_visible
            custom float[] outputs:lat
            custom float[] outputs:lon
            custom float[] outputs:pitch
            custom float[] outputs:roll
            custom token[] outputs:target_name
            custom int[] outputs:x1
            custom int[] outputs:x2
            custom int[] outputs:y1
            custom int[] outputs:y2
            custom float[] outputs:yaw
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (558.7068, -115.62485)
        }

        def OmniGraphNode "ros2_publisher" (
            prepend apiSchemas = ["NodeGraphNodeAPI"]
        )
        {
            custom float[] inputs:alt
            prepend float[] inputs:alt.connect = </Root/BboxExport/bbox_projector.outputs:alt>
            custom uint64 inputs:context
            prepend uint64 inputs:context.connect = </Root/BboxExport/ros2_context.outputs:context>
            custom float[] inputs:distance_x
            prepend float[] inputs:distance_x.connect = </Root/BboxExport/bbox_projector.outputs:distance_x>
            custom float[] inputs:distance_y
            prepend float[] inputs:distance_y.connect = </Root/BboxExport/bbox_projector.outputs:distance_y>
            custom float[] inputs:distance_z
            prepend float[] inputs:distance_z.connect = </Root/BboxExport/bbox_projector.outputs:distance_z>
            custom uint inputs:execIn (
                customData = {
                    bool isExecution = 1
                }
            )
            prepend uint inputs:execIn.connect = </Root/BboxExport/on_playback_tick.outputs:tick>
            custom token inputs:header:frame_id
            custom uint inputs:header:stamp:nanosec
            prepend uint inputs:header:stamp:nanosec.connect = </Root/BboxExport/seconds_to_ros_stamp.outputs:nanosec>
            custom int inputs:header:stamp:sec
            prepend int inputs:header:stamp:sec.connect = </Root/BboxExport/seconds_to_ros_stamp.outputs:sec>
            custom bool[] inputs:in_frame
            prepend bool[] inputs:in_frame.connect = </Root/BboxExport/bbox_projector.outputs:in_frame>
            custom bool[] inputs:is_visible
            prepend bool[] inputs:is_visible.connect = </Root/BboxExport/bbox_projector.outputs:is_visible>
            custom float[] inputs:lat
            prepend float[] inputs:lat.connect = </Root/BboxExport/bbox_projector.outputs:lat>
            custom float[] inputs:lon
            prepend float[] inputs:lon.connect = </Root/BboxExport/bbox_projector.outputs:lon>
            custom string inputs:messageName = "FrameBboxes"
            custom string inputs:messagePackage = "isaac_core_ros2_msgs"
            custom string inputs:messageSubfolder
            custom string inputs:nodeNamespace
            custom float[] inputs:pitch
            prepend float[] inputs:pitch.connect = </Root/BboxExport/bbox_projector.outputs:pitch>
            custom string inputs:qosProfile
            custom uint64 inputs:queueSize
            custom float[] inputs:roll
            prepend float[] inputs:roll.connect = </Root/BboxExport/bbox_projector.outputs:roll>
            custom token[] inputs:target_name
            prepend token[] inputs:target_name.connect = </Root/BboxExport/bbox_projector.outputs:target_name>
            custom string inputs:topicName = "/isaac_core/bbox"
            custom int[] inputs:x1
            prepend int[] inputs:x1.connect = </Root/BboxExport/bbox_projector.outputs:x1>
            custom int[] inputs:x2
            prepend int[] inputs:x2.connect = </Root/BboxExport/bbox_projector.outputs:x2>
            custom int[] inputs:y1
            prepend int[] inputs:y1.connect = </Root/BboxExport/bbox_projector.outputs:y1>
            custom int[] inputs:y2
            prepend int[] inputs:y2.connect = </Root/BboxExport/bbox_projector.outputs:y2>
            custom float[] inputs:yaw
            prepend float[] inputs:yaw.connect = </Root/BboxExport/bbox_projector.outputs:yaw>
            token node:type = "isaacsim.ros2.bridge.ROS2Publisher"
            int node:typeVersion = 1
            custom uint outputs:execOut (
                customData = {
                    bool isExecution = 1
                }
            )
            uniform token ui:nodegraph:node:expansionState = "open"
            uniform float2 ui:nodegraph:node:pos = (1099.6307, -210.66374)
        }
    }
}

def CesiumDataPrim "Cesium"
{
    prepend rel cesium:selectedIonServer = </CesiumServers/IonOfficial>
}

def CesiumGeoreferencePrim "CesiumGeoreference"
{
    matrix4d cesium:ecefToUsdTransform = ( (0.9647534819407177, 0.1682239812131189, -0.20236455032458023, 0), (-0.2631553136139595, 0.6167258011721835, -0.741888513919219, 0), (2.7755575615628914e-17, 0.7689928337204038, 0.6392573986170699, 0), (-1.1260326425004901e-10, 21025.701877878048, -6371656.822771804, 1) )
}

def "CesiumServers"
{
    def CesiumIonServerPrim "IonOfficial"
    {
        string cesium:displayName = "ion.cesium.com"
        string cesium:ionServerApiUrl = "https://api.cesium.com/"
        int64 cesium:ionServerApplicationId = 413
        string cesium:ionServerUrl = "https://ion.cesium.com/"
    }
}
