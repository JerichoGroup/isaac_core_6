{
  "Ros2GlobalPosePublisher": {
    "version": 1,
    "description": "Publish global position and orientation to a ROS 2 GeoPoseStamped topic. Rate-limited by the hz input. Orientation is published as degrees in the quaternion x/y/z fields (legacy convention preserved from the previous generation).",
    "language": "Python",
    "metadata": {
      "uiName": "ROS2 Global Pose Publisher"
    },
    "inputs": {
      "execIn": {
        "type": "execution",
        "description": "Tick input for publishing",
        "default": 0,
        "metadata": {
          "uiName": "Exec In"
        }
      },
      "topic_name": {
        "type": "string",
        "description": "ROS 2 topic name to publish GeoPoseStamped to",
        "default": "/isaac_core/global_pose",
        "metadata": {
          "uiName": "Topic Name"
        }
      },
      "global_position": {
        "type": "vectord[3]",
        "description": "Global position [lat_deg, lon_deg, alt_m]",
        "default": [0.0, 0.0, 0.0],
        "metadata": {
          "uiName": "Global Position"
        }
      },
      "global_orientation": {
        "type": "vectord[3]",
        "description": "Global orientation [roll, pitch, yaw] ENU radians",
        "default": [0.0, 0.0, 0.0],
        "metadata": {
          "uiName": "Global Orientation"
        }
      },
      "hz": {
        "type": "int",
        "description": "Publishing frequency in Hz",
        "default": 10,
        "metadata": {
          "uiName": "Rate Hz"
        }
      }
    },
    "outputs": {}
  }
}
