{
  "Ros2Gimbal": {
    "version": 1,
    "description": "Subscribe to a ROS 2 gimbal topic and output roll/pitch/yaw offsets in degrees. Uses start_* values until the first message arrives.",
    "language": "Python",
    "metadata": {
      "uiName": "ROS2 Gimbal"
    },
    "inputs": {
      "execIn": {
        "type": "execution",
        "description": "Execution trigger to read ROS 2 messages",
        "default": 0,
        "metadata": {
          "uiName": "Exec In"
        }
      },
      "gimbal_topic": {
        "type": "string",
        "description": "ROS 2 topic for Gimbal(roll, pitch, yaw) in degrees",
        "default": "/isaac_core/gimbal",
        "metadata": {
          "uiName": "Gimbal Topic"
        }
      },
      "start_roll_deg": {
        "type": "float",
        "description": "Initial roll offset in degrees, used before first message",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Roll (deg)"
        }
      },
      "start_pitch_deg": {
        "type": "float",
        "description": "Initial pitch offset in degrees, used before first message",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Pitch (deg)"
        }
      },
      "start_yaw_deg": {
        "type": "float",
        "description": "Initial yaw offset in degrees, used before first message",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Yaw (deg)"
        }
      }
    },
    "outputs": {
      "roll_deg": {
        "type": "float",
        "description": "Current gimbal roll offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Roll (deg)"
        }
      },
      "pitch_deg": {
        "type": "float",
        "description": "Current gimbal pitch offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Pitch (deg)"
        }
      },
      "yaw_deg": {
        "type": "float",
        "description": "Current gimbal yaw offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Yaw (deg)"
        }
      }
    }
  }
}
