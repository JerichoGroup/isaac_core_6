{
    "DistanceSensor": {
        "version": 1,
        "description": [
            "Report the distance from a camera to the first thing at the centre of its view.",
            "",
            "Boresighted by construction: the ray is cast along the camera prim's own local -Z, so it",
            "follows the camera wherever the gimbal aims it and cannot drift out of alignment. Casting",
            "along a separate sensor prim's axis was permanently 90 degrees off, because the camera",
            "carries its own local orientation while a plain Xform does not.",
            "",
            "Uses the RENDER raycast, not PhysX: Cesium 3D Tiles terrain has no collision geometry, so a",
            "physics raycast never hits the ground."
        ],
        "language": "Python",
        "metadata": {
            "uiName": "Distance Sensor"
        },
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Tick input. The raycast runs once per tick",
                "default": 0,
                "metadata": {
                    "uiName": "Exec In"
                }
            },
            "cameraPath": {
                "type": "token",
                "default": "",
                "description": "Absolute prim path of the camera to range along, e.g. '/World/Environment/drone_0/Xform/main_camera_01'. The ray is cast along this prim's local -Z, which is the USD camera convention, so it always points at the centre of the camera's view -- a boresighted rangefinder. A plain path rather than a USD relationship because the camera lives in a different layer and the GUI's relationship picker cannot see it; the stage compositor writes this from config.",
                "metadata": {
                    "uiName": "Camera Path"
                }
            },
            "min_range_m": {
                "type": "float",
                "description": "Rated minimum measurable distance in metres. A closer hit reports -inf",
                "default": 0.2,
                "metadata": {
                    "uiName": "Min Range (m)"
                }
            },
            "max_range_m": {
                "type": "float",
                "description": "Rated maximum measurable distance in metres. A farther hit, or no hit, reports +inf",
                "default": 100.0,
                "metadata": {
                    "uiName": "Max Range (m)"
                }
            }
        },
        "outputs": {
            "range_m": {
                "type": "float",
                "description": "Distance to the first hit in metres, or +inf / -inf per sensor_msgs/Range convention. Wire to the publisher's range input Float, not double, to match sensor_msgs/Range's float32 fields.",
                "default": 0.0,
                "metadata": {
                    "uiName": "Range (m)"
                }
            },
            "min_range_out": {
                "type": "float",
                "description": "Pass-through of min_range_m, so the publisher's min_range comes from the same source of truth Float, not double, to match sensor_msgs/Range's float32 fields.",
                "default": 0.2,
                "metadata": {
                    "uiName": "Min Range Out"
                }
            },
            "max_range_out": {
                "type": "float",
                "description": "Pass-through of max_range_m, so the publisher's max_range comes from the same source of truth Float, not double, to match sensor_msgs/Range's float32 fields.",
                "default": 100.0,
                "metadata": {
                    "uiName": "Max Range Out"
                }
            },
            "hit": {
                "type": "bool",
                "description": "Whether the ray struck anything within max_range_m. Useful for debugging without interpreting the infinities",
                "default": false,
                "metadata": {
                    "uiName": "Hit"
                }
            }
        }
    }
}
